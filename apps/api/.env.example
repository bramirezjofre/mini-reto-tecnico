# Backend NestJS
PORT=3001
GITHUB_API_BASE_URL=https://api.github.com
# Optional: personal access token to lift GitHub rate limit (60/hr -> 5000/hr)
GITHUB_TOKEN=
# Request timeout when calling GitHub, in milliseconds
GITHUB_TIMEOUT_MS=5000
# Comma-separated allowlist for browser CORS origins. Use "*" to allow any.
CORS_ORIGIN=http://localhost:3000,http://web:3000
